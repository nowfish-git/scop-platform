# ===========================================
# SCOP 智慧社区运营平台 — 环境变量模板
# 复制此文件为 .env 并填入真实值
# ===========================================

# --- 数据库 ---
DATABASE_URL="postgresql://scop:scop_dev_2026@localhost:5432/scop_platform?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- JWT 认证 ---
JWT_SECRET="change-me-to-a-random-256-bit-string"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# --- 微信小程序 ---
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""

# --- 腾讯云 COS ---
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_BUCKET="scop-platform-1234567890"
COS_REGION="ap-guangzhou"

# --- EMQX (MQTT) ---
MQTT_HOST="localhost"
MQTT_PORT="1883"
MQTT_WS_PORT="8083"

# --- Elasticsearch ---
ES_NODE="http://localhost:9200"

# --- 应用端口 ---
API_GATEWAY_PORT=3000
USER_SVC_PORT=3001
COMMUNITY_SVC_PORT=3002
FAMILY_SVC_PORT=3010
SERVICE_SVC_PORT=3011
MARKET_SVC_PORT=3012
IOT_SVC_PORT=3013
AI_SVC_PORT=3014
NOTIFY_SVC_PORT=3004
PAYMENT_SVC_PORT=3008
DATA_SVC_PORT=3009
WEB_STATION_PORT=5173
WEB_ADMIN_PORT=5174
WEB_MERCHANT_PORT=5175
